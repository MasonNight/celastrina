0a69","sha1":"7a5da08da880ce2ce36533a483e93fe4c18af3e3"},{"name":"Murder_at_Midnight_1931_512kb.mp4","source":"derivative","format":"512Kb MPEG4","original":"Murder_at_Midnight_1931.avi","md5":"944a083549d78df50db3d89c5fcab22f","mtime":"1277411517","size":"287946916","crc32":"a645b5d8","sha1":"44a4e09f77150f8f5a2976e41356cf4552bcff99","length":"3985.08","height":"240","width":"320"},{"name":"Murder_at_Midnight_1931_archive.torrent","source":"metadata","btih":"2fdeb6674bdc47f82c568d987052a5b2b393e9eb","mtime":"1762315978","size":"30447","md5":"4044406f270b5a638c92ca680f47d36e","crc32":"a187a65e","sha1":"2d1a073682f85c26efc0bb94ae2f218bd2b97394","format":"Archive BitTorrent"},{"name":"Murder_at_Midnight_1931_files.xml","source":"original","format":"Metadata","md5":"8179ae0cbdaf53723da91c5f3dca236c","summation":"md5"},{"name":"Murder_at_Midnight_1931_meta.xml","source":"original","format":"Metadata","mtime":"1762315967","size":"1128","md5":"42cfe36be38a28060cef115217e2e695","crc32":"ac0368d2","sha1":"4b016abecb5f8bb5655bef08f766cd40188895c2"},{"name":"Murder_at_Midnight_1931_reviews.xml","source":"original","mtime":"1568411544","size":"2936","format":"Metadata","md5":"1f588338b6c5987159fadb868baa414f","crc32":"a9675505","sha1":"8ee6d04cb283fb969e15550a41fc3f1e700b8717"},{"name":"__ia_thumb.jpg","source":"original","mtime":"1762233576","size":"4515","md5":"8e8ae4d5e9879c272f1f2a94190bc796","crc32":"0cd2f81a","sha1":"33cadd5d886bb0382eeedfc3b66ae332d00ac280","format":"Item Tile","rotation":"0"}],"files_count":77,"item_last_updated":1762315978,"item_size":1466712628,"metadata":{"identifier":"Murder_at_Midnight_1931","title":"Murder at Midnight","mediatype":"movies","collection":["Comedy_Films","feature_films","moviesandfilms"],"description":"Gun used during charades turns out to be loaded with real ammo instead of blanks.","date":"1931","year":"1931","subject":"murder;mystery;charades","licenseurl":"http://creativecommons.org/licenses/by/3.0/","publicdate":"2010-06-24 19:04:36","addeddate":"2010-06-24 19:03:39","uploader":"w_a_x_man@yahoo.com","director":"Frank R. Strayer","sound":"sound","color":"black & white","runtime":"1:06:25","updatedate":"2010-06-24 19:05:34","updater":"Moongleam","backup_location":"ia903605_25","ia_orig__runtime":"66 minutes 25 seconds","collection_added":["feature_films","moviesandfilms"]},"reviews":[{"reviewbody":"Well presented, and with a light comedy touch, a conspiracy resulting in 4 murders can be solved just by following the story.\n\nHow did the detective know the second death was murder and not suicide when he declared it to the household at the beginning of the second act? I don't know. No clues are shown or reason given. A motive isn't discovered until a little later. The explanation given by the criminologist as to how the device used in the last murder (and for something else, but I won't tell) worked seemed a stretch. These points aside, I very much enjoyed the show. It kept me engaged.\n\nThere are some interesting characters to watch, good acting, and the director uses unusual camera angles for effect, and they mostly worked well.\n\nI downloaded the 408MB AVI file. Video is in good shape. The dialog is understandable, but there is an oppressive hiss throughout.","reviewtitle":"Give It A Watch","reviewer":"billbarstad","reviewdate":"2011-05-26 21:07:18","createdate":"2010-06-25 03:07:44","stars":"4"},{"reviewbody":"photophone thingy, grt job!!","reviewtitle":"RCA","reviewer":"splue","reviewdate":"2011-05-26 21:48:46","createdate":"2011-05-26 21:48:46","stars":"5"},{"reviewbody":"The film has some promise at the start and has a bit of a bang at the end. In between we are stuck with the stock character collection of mystery stalwarts: the grump, dead-pan Police Inspector; a suave, even-tempered criminologist, who is asked to help the police because he was present when the murder occurred; the murder victim with no enemies; the victim's attractive wife who doesn't know a thing; her aunt, an officious, domineering busy-body; her brother, a high-strung young man, who is a nervous wreck for no apparent reason; the beautiful maid who is his lover (did Alice White have the sexiest wiggle-walk or what?); a near-sighted, wimpy lawyer who knows more than he tells at first; and a few other maids, police officers, friends of he dead man, etc. For the middle 50 minutes, we see unidentified hands at work, policeman decoyed away from their posts, interrogations that mostly just take up screen time and a lot of walking back and forth. Personally, I like the Mr. Wong (The Mystery of Mr. Wong) version much better.","reviewtitle":"Meandering Murder Mystery","reviewer":"Poohbah70","reviewer_itemname":"@poohbah70","reviewdate":"2019-09-13 21:52:23","createdate":"2019-09-13 21:52:23","stars":"3"}],"server":"dn600301.us.archive.org","simplelists":{"solo_manifest":{"solo_manifest_dn600301":{"sys_changed_by":{"source":"task","task_id":"5418331116"},"sys_last_changed":"2026-06-05 09:36:28.286069"}}},"solo":true,"uniq":445846660,"workable_servers":["dn600301.us.archive.org"]}